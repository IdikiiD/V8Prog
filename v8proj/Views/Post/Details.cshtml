@using v8proj.Core.Entities
@using v8proj.Core.Model.DTO.Report
@model Post

@{
    var userEmailCookie = Request.Cookies["UserEmail"];
    int? currentUserId = null;

    if (userEmailCookie != null)
    {
        var userEmail = userEmailCookie.Value;
        var db = new v8proj.DAL.ApplicationDbContext();
        var currentUser = db.Users.FirstOrDefault(u => u.Email == userEmail);
        if (currentUser != null)
        {
            currentUserId = currentUser.UserId;
        }
    }

    bool isFavorite = Model.FavoritedBy?.Any(u => u.UserId == currentUserId) ?? false;
    string heartClass = isFavorite ? "bi-heart-fill" : "bi-heart";

    ViewBag.Title = "Post Details";

    var images = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImagePath1)) { images.Add(Model.ImagePath1); }
    if (!string.IsNullOrEmpty(Model.ImagePath2)) { images.Add(Model.ImagePath2); }
    if (!string.IsNullOrEmpty(Model.ImagePath3)) { images.Add(Model.ImagePath3); }

    string gridColsClass = images.Count == 1 ? "grid-cols-1 place-items-center"
        : images.Count == 2 ? "grid-cols-2"
        : "grid-cols-3";
}

<div class="container mx-auto py-8">
    <h1 class="text-3xl font-bold mb-6">@Model.Title</h1>

    <div class="mb-4">
        <strong>Category:</strong> @Model.Category
    </div>

    @if (images.Count > 0)
    {
        <div class="grid gap-4 mb-6 @gridColsClass">
            @foreach (var img in images)
            {
                <div class="image-container">
                    <img src="@Url.Action("Image", "Post", new { file = System.IO.Path.GetFileName(img) })"
                         alt="Post image" class="w-full h-64 object-cover rounded-lg shadow-md click-to-enlarge" />
                </div>
            }
        </div>
    }

    <div class="bg-white p-6 rounded-lg shadow-inner mb-6">
        <p class="text-gray-800 text-lg">@Model.Description</p>
    </div>

    <p class="text-gray-600">Published: @Model.CreatedAt.ToLongDateString()</p>

    <div class="flex justify-between items-center mt-4">
        <a href="@Url.Action("Index", "Home")" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded inline-flex items-center">
            Back to List
        </a>
        <button type="button"
                class="bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 px-4 rounded ml-4"
                data-bs-toggle="modal" data-bs-target="#supportModal">
            Support the Author
        </button>

        <button type="button"
                class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded ml-4"
                data-bs-toggle="modal" data-bs-target="#reportModal">
            Report Post
        </button>

        @{
            string buttonText = isFavorite ? "Remove from Favorites" : "Add to Favorites";
            string isFavoriteAttr = isFavorite ? "true" : "false";
        }

        <span id="add-to-favorites"
              class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded inline-flex items-center cursor-pointer"
              data-post-id="@Model.Id"
              data-is-favorite="@isFavoriteAttr">
            @buttonText
        </span>
    </div>
</div>

<div class="modal fade" id="supportModal" tabindex="-1" role="dialog" aria-labelledby="supportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="supportModalLabel">Support the Author</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" action="/Support/Support">
                <div class="modal-body">
                    <div class="form-group">
                        <label for="amount">Amount (₽):</label>
                        <input type="number" class="form-control" id="amount" name="Amount" required min="10">
                    </div>

                    <div class="form-group">
                        <label for="comment">Comment (optional):</label>
                        <textarea class="form-control" id="comment" name="Comment"></textarea>
                    </div>

                    <div class="form-group">
                        <label for="cardNumber">Card Number (16 digits):</label>
                        <input type="text" class="form-control" id="cardNumber" name="CardNumber" required maxlength="16" pattern="\d{16}" placeholder="0000 0000 0000 0000">
                    </div>

                    <div class="form-group">
                        <label for="expiryDate">Expiry Date:</label>
                        <div class="d-flex">
                            <input type="number" class="form-control" id="expiryMonth" name="ExpiryMonth" required maxlength="2" placeholder="MM" min="01" max="12" pattern="\d{2}" style="width: 80px;">
                            <span class="mx-2">/</span>
                            <input type="number" class="form-control" id="expiryYear" name="ExpiryYear" required maxlength="2" placeholder="YY" min="22" max="99" pattern="\d{2}" style="width: 80px;">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="cvv">CVV:</label>
                        <input type="text" class="form-control" id="cvv" name="CVV" required maxlength="3" pattern="\d{3}" placeholder="123">
                    </div>

                    <input type="hidden" name="PostId" value="@Model.Id" />
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Support</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="reportModal" tabindex="-1" role="dialog" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reportModalLabel">Report to post</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("ReportPost", "Post", FormMethod.Post, new { id = "reportForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id, new { name = "PostId" })
                <div class="modal-body">
                    <div class="form-group">
                        <label for="reason">Причина жалобы:</label>
                        <textarea class="form-control" id="reason" name="Reason" rows="5" required minlength="10" maxlength="500"></textarea>
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Send report</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const supportBtn = document.getElementById("supportBtn");
            if (supportBtn) {
                supportBtn.addEventListener("click", function(e) {
                    e.preventDefault();
                    document.getElementById("supportForm").submit();
                    setTimeout(function() {
                        window.location.href = '/thankyou.html';
                    }, 2000);
                });
            }

            const addToFavoritesBtn = document.getElementById("add-to-favorites");
            if (addToFavoritesBtn) {
                addToFavoritesBtn.addEventListener("click", function () {
                    const btn = this;
                    const postId = btn.getAttribute("data-post-id");
                    const isFavorite = btn.getAttribute("data-is-favorite") === "true";

                    fetch(`/Post/ToggleFavorite/${postId}`, {
                        method: "POST"
                    }).then(res => {
                        if (res.ok) {
                            const newState = !isFavorite;
                            btn.setAttribute("data-is-favorite", newState ? "true" : "false");
                            btn.textContent = newState ? "Remove from Favorites" : "Add to Favorites";
                        } else {
                            alert("Something went wrong.");
                        }
                    });
                });
            }

            const reportForm = document.getElementById("reportForm");
            if (reportForm) {
                reportForm.addEventListener("submit", function(e) {
                    const reasonInput = document.getElementById("reason");
                    if (reasonInput.value.length < 10 || reasonInput.value.length > 500) {
                        alert("Причина жалобы должна быть от 10 до 500 символов.");
                        e.preventDefault();
                    }
                });
            }

            const images = document.querySelectorAll('.click-to-enlarge');
            images.forEach(img => {
                img.addEventListener('click', function () {
                    let overlay = document.createElement('div');
                    overlay.style.position = 'fixed';
                    overlay.style.top = '0';
                    overlay.style.left = '0';
                    overlay.style.width = '100vw';
                    overlay.style.height = '100vh';
                    overlay.style.backgroundColor = 'rgba(0, 0, 0, 0.5)';
                    overlay.style.display = 'none';
                    overlay.style.justifyContent = 'center';
                    overlay.style.alignItems = 'center';
                    overlay.style.zIndex = '9999';
                    document.body.appendChild(overlay);

                    let largeImage = document.createElement('img');
                    largeImage.src = img.src;
                    largeImage.style.maxWidth = '90%';
                    largeImage.style.maxHeight = '90%';
                    largeImage.style.borderRadius = '10px';
                    largeImage.style.objectFit = 'contain';
                    overlay.innerHTML = '';
                    overlay.appendChild(largeImage);
                    overlay.style.display = 'flex';

                    overlay.addEventListener('click', function () {
                        overlay.style.display = 'none';
                        overlay.remove();
                    });
                    document.body.appendChild(overlay);
                });
            });
        });
    </script>
}