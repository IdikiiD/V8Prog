@model v8proj.Web.ViewModels.ProfileViewModel

<h2>Профиль</h2>

@if (Model != null)
{
    <div>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Имя:</strong> @Model.FullName</p>
        <p><strong>Дата регистрации:</strong> @Model.RegistrationDate.ToLongDateString()</p>

        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
        {
            <p><strong>Номер телефона:</strong> @Model.PhoneNumber</p>
        }
        else
        {
            <p>Номер телефона не добавлен.</p>
            using (Html.BeginForm("AddPhoneNumber", "Profile", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div>
                    @Html.TextBoxFor(m => m.NewPhoneNumber, new { placeholder = "Введите номер телефона" })
                    <button type="submit">Добавить номер</button>
                </div>
            }
        }

        <p><strong>Аватар:</strong></p>
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" alt="Аватар" style="width:150px;height:150px;" />
        }
        else
        {
            <p>Аватар не загружен.</p>
        }
    </div>
}
else
{
    <p>Нет данных для отображения.</p>
}