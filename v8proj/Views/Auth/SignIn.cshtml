@using v8proj.Core.Constant
@model v8proj.Core.Model.DTO.User.SignInDto

@{
    ViewBag.Title = "Вход";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="container mx-auto px-4 py-8">
    <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8">
        <h2 class="text-2xl font-bold mb-6 text-center text-black">Вход</h2>

        @* --- НАЧАЛО: Добавляем ValidationSummary для общих ошибок модели --- *@
        @* Параметр true означает "не включать ошибки свойств" (т.к. они показываются через ValidationMessageFor) *@
        @* Второй параметр "" - это сообщение перед списком ошибок (можно оставить пустым) *@
        @* Третий параметр - html атрибуты для стилизации (здесь Tailwind классы для красного текста) *@
        @Html.ValidationSummary(true, "", new { @class = "text-red-600 text-sm mb-4 list-disc list-inside" })
        @* --- КОНЕЦ: Добавляем ValidationSummary --- *@

        @if (TempData[TempDataKeys.Error] != null)
        {
            @* Можно стилизовать TempData под Tailwind, если нужно *@
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">@TempData[TempDataKeys.Error]</span>
            </div>
        }

        @using (Html.BeginForm("SignIn", "Auth", FormMethod.Post, new { @class = "form" }))
        {
            @Html.AntiForgeryToken() @* <-- ВАЖНО: Добавьте AntiForgeryToken, если его нет *@

            <div>
                @Html.LabelFor(m => m.Email ,
                    new {@class = "block text-dark-700 mb-2"
                    })
                @Html.TextBoxFor(m => m.Email, new { @class ="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-black", @placeholder = "Email", @required = "required" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-xs mt-1" }) @* Добавил mt-1 для небольшого отступа *@
            </div>
            <div class="mt-4"> @* Добавил mt-4 для отступа между полями *@
                @Html.LabelFor(m => m.Password ,
                    new {@class = "block text-dark-700 mb-2" @* Убрал mt-1.5, т.к. есть отступ у div *@
                    })
                @Html.PasswordFor(m => m.Password, new { @class = "w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-black", @placeholder = "Password", @required = "required" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-red-500 text-xs mt-1" }) @* Добавил mt-1 *@
            </div>
            <div class="flex items-center justify-between mt-4"> @* Добавил mt-4 *@
                <div class="flex items-center">
                    @* Здесь мог бы быть чекбокс "Запомнить меня", если нужно *@
                </div>
                <a href="@Url.Action("ForgotPassword", "Home")" class="text-sm text-black hover:text-gray-700">Забыли пароль?</a> @* Сделал текст поменьше и убрал лишние отступы, т.к. они теперь у родительского div *@
            </div>
            <button type="submit" class="w-full bg-black text-white py-2 rounded-lg hover:bg-gray-800 mt-6">Войти</button> @* Убрал href, добавил mt-6 *@
        }

        <p class="mt-6 text-center text-sm text-gray-600"> @* Добавил mt-6 и уменьшил текст *@
            Нет аккаунта? <a href="@Url.Action("SignUp", "Auth")" class="font-medium text-black hover:text-gray-700">Зарегистрироваться</a> @* Изменил контроллер на Auth для SignUp *@
        </p>
    </div>
</main>