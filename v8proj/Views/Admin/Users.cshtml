@model List<v8proj.Core.Model.DTO.User.UserDto>
@using System.Linq 
@using v8proj.Core.Enums.Entinity 
@{
    ViewBag.Title = "Users";
    
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-6">Users</h1>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">@TempData["Error"]</span>
        </div>
    }

    @* --- НАЧАЛО: ДОБАВЛЕННАЯ ФОРМА ПОИСКА --- *@
    @using (Html.BeginForm("Users", "Admin", FormMethod.Get, new { @class = "mb-6 flex items-center" }))
    {
        <div class="relative flex-grow mr-2"> 
            @Html.TextBox("searchString", ViewBag.CurrentSearch as string,
                new {
                    @class = "w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                    placeholder = "Search by Name or Email..." 
                })
        </div>
        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
            Search 
        </button>
        if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
        {
            <a href="@Url.Action("Users", "Admin")" class="ml-3 text-sm text-gray-600 hover:text-blue-600">Clear</a> 
        }
    }
    @* --- КОНЕЦ: ДОБАВЛЕННАЯ ФОРМА ПОИСКА --- *@


    <table class="min-w-full bg-white border border-gray-200 shadow-md rounded">
        <thead>
        <tr class="bg-gray-200 text-left text-sm font-semibold text-gray-700 uppercase">
            <th class="py-3 px-4 border-b">ID</th>
            <th class="py-3 px-4 border-b">Name</th>
            <th class="py-3 px-4 border-b">Email</th>
            <th class="py-3 px-4 border-b">Registration date</th>
            <th class="py-3 px-4 border-b">Status</th>
            <th class="py-3 px-4 border-b">Actions</th>
        </tr>
        </thead>
        <tbody class="text-gray-700">
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <tr class="hover:bg-gray-50 border-b border-gray-200">
                    <td class="py-3 px-4">@user.Id</td>
                    <td class="py-3 px-4">@user.FullName</td>
                    <td class="py-3 px-4">@user.Email</td>
                    <td class="py-3 px-4">@user.DateRegistered.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="py-3 px-4">

                        @if (user.UserStatus == v8proj.Core.Enums.Entinity.EntityStatus.Banned)
                        {
                            <span class="text-red-600 font-semibold">@user.UserStatus.ToString()</span>
                        }
                        else
                        {
                            <span class="text-green-600 font-semibold">@user.UserStatus.ToString()</span>
                        }
                    </td>
                    <td class="py-3 px-4">

                        @if (user.UserStatus != v8proj.Core.Enums.Entinity.EntityStatus.Banned)
                        {
                            using (Html.BeginForm("BanUser", "Admin", FormMethod.Post, new { @class="inline-block" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm" onclick="return confirm('Are you sure, you want to ban this user? @user.Email?');">Ban</button>
                            }
                        }
                        else
                        {
                            using (Html.BeginForm("UnbanUser", "Admin", FormMethod.Post, new { @class="inline-block" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm" onclick="return confirm('Are you sure, you want to unban this user? @user.Email?');">Unban</button>
                            }
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center py-4">Users not found.</td>
            </tr>
        }
        </tbody>
    </table>

</div>
</body>
</html>