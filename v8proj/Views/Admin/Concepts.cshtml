@{
    ViewBag.Title = "Concept Art";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Concept Art</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-6">Concept Art</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-lg shadow-md">
            <img src="https://via.placeholder.com/150" alt="Concept" class="mb-4">
            <h2 class="text-lg font-bold">Concept Title</h2>
            <p>Author: Ivan Ivanov</p>
            <button class="bg-red-500 text-white px-4 py-2 rounded mt-2">Delete</button>
        </div>
    </div>
</div>
</body>
</html>
