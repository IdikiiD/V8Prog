@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main class="container mx-auto px-4 py-8">
<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-6">Admin Dashboard</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Concept Art Management -->
        <a href="@Url.Action("Concepts", "Admin")" class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg">
            <h2 class="text-xl font-bold">Concept Art</h2>
            <p>View and moderate concepts</p>
        </a>

        <!-- User Management -->
        <a href="@Url.Action("Users", "Admin")" class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg">
            <h2 class="text-xl font-bold">Users</h2>
            <p>Manage registered users</p>
        </a>

        <!-- Settings -->
        <a href="@Url.Action("Settings", "Admin")" class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg">
            <h2 class="text-xl font-bold">Settings</h2>
            <p>Site configuration</p>
        </a>
    </div>
</div>
</main>
