@{
    ViewBag.Title = "Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <meta charset="UTF-8">
}

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8 text-center">Car Categories</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        <div class="p-4 bg-white rounded shadow hover:shadow-lg transition">
            <i class="fas fa-car-side text-4xl mb-2 text-blue-500"></i>
            <a href="@Url.Action("Index", "Home", new { category = "Sedan" })">
                <h2 class="text-xl font-semibold">Sedan</h2>
            </a>
        </div>

        <div class="p-4 bg-white rounded shadow hover:shadow-lg transition">
            <i class="fas fa-truck-monster text-4xl mb-2 text-green-500"></i>
            <a href="@Url.Action("Index", "Home", new { category = "SUV" })">
                <h2 class="text-xl font-semibold">SUV</h2>
            </a>
        </div>

        <div class="p-4 bg-white rounded shadow hover:shadow-lg transition">
            <i class="fas fa-truck-pickup text-4xl mb-2 text-yellow-500"></i>
            <a href="@Url.Action("Index", "Home", new { category = "Pickup" })">
                <h2 class="text-xl font-semibold">Pickup</h2>
            </a>
        </div>

        <div class="p-4 bg-white rounded shadow hover:shadow-lg transition">
            <i class="fas fa-car text-4xl mb-2 text-red-500"></i>
            <a href="@Url.Action("Index", "Home", new { category = "Convertible" })">
                <h2 class="text-xl font-semibold">Convertible</h2>
            </a>
        </div>
    </div>


</div>